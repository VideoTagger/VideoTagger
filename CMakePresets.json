{
	"version": 6,
	"configurePresets": [
		{
			"name": "windows-base",
			"hidden": true,
			"generator": "Ninja",
			"cacheVariables": {
				"CMAKE_C_COMPILER": "cl.exe",
				"CMAKE_CXX_COMPILER": "cl.exe"
			},
			"condition": {
				"type": "equals",
				"lhs": "${hostSystemName}",
				"rhs": "Windows"
			}
		},
		{
			"name": "linux-base",
			"hidden": true,
			"generator": "Ninja",
			"cacheVariables": {
				"CMAKE_C_COMPILER": "gcc",
				"CMAKE_CXX_COMPILER": "g++"
			},
			"condition": {
				"type": "equals",
				"lhs": "${hostSystemName}",
				"rhs": "Linux"
			},
			"vendor": {
				"microsoft.com/VisualStudioRemoteSettings/CMake/1.0": {
					"sourceDir": "$env{HOME}/.vs/$ms{projectDirName}"
				}
			}
		},
		{
			"name": "macos-base",
			"hidden": true,
			"generator": "Ninja",
			"cacheVariables": {
				"CMAKE_C_COMPILER": "clang",
				"CMAKE_CXX_COMPILER": "clang++"
			},
			"condition": {
				"type": "equals",
				"lhs": "${hostSystemName}",
				"rhs": "Darwin"
			},
			"vendor": {
				"microsoft.com/VisualStudioRemoteSettings/CMake/1.0": {
					"sourceDir": "$env{HOME}/.vs/$ms{projectDirName}"
				}
			}
		},
		{
			"name": "windows-x64-debug",
			"displayName": "x64 Debug",
			"inherits": "windows-base",
			"binaryDir": "${sourceDir}/build/cmake/${hostSystemName}-x86_64/Debug/",
			"installDir": "${sourceDir}/build/cmake/install/${hostSystemName}-x86_x64/Debug/",
			"architecture": {
				"value": "x64",
				"strategy": "external"
			},
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Debug"
			}
		},
		{
			"name": "windows-x64-release",
			"displayName": "x64 Release",
			"inherits": "windows-base",
			"binaryDir": "${sourceDir}/build/cmake/${hostSystemName}-x86_64/Release/",
			"installDir": "${sourceDir}/build/cmake/install/${hostSystemName}-x86_x64/Release/",
			"architecture": {
				"value": "x64",
				"strategy": "external"
			},
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Release"
			}
		},
		{
			"name": "windows-x64-shipping",
			"displayName": "x64 Shipping",
			"inherits": "windows-base",
			"binaryDir": "${sourceDir}/build/cmake/${hostSystemName}-x86_64/Shipping/",
			"installDir": "${sourceDir}/build/cmake/install/${hostSystemName}-x86_x64/Shipping/",
			"architecture": {
				"value": "x64",
				"strategy": "external"
			},
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Release",
				"VT_BUILD_SHIPPING": "true"
			}
		},
		{
			"name": "linux-debug",
			"displayName": "x64 Debug",
			"inherits": "linux-base",
			"binaryDir": "${sourceDir}/build/cmake/${hostSystemName}-x86_64/Debug/",
			"installDir": "${sourceDir}/build/cmake/install/${hostSystemName}-x86_x64/Debug/",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Debug"
			}
		},
		{
			"name": "linux-release",
			"displayName": "x64 Release",
			"inherits": "linux-base",
			"binaryDir": "${sourceDir}/build/cmake/${hostSystemName}-x86_64/Release/",
			"installDir": "${sourceDir}/build/cmake/install/${hostSystemName}-x86_x64/Release/",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Release"
			}
		},
		{
			"name": "linux-shipping",
			"displayName": "x64 Shipping",
			"inherits": "linux-base",
			"binaryDir": "${sourceDir}/build/cmake/${hostSystemName}-x86_64/Shipping/",
			"installDir": "${sourceDir}/build/cmake/install/${hostSystemName}-x86_x64/Shipping/",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Release",
				"VT_BUILD_SHIPPING": "true"
			}
		},
		{
			"name": "macos-debug",
			"displayName": "x64 Debug",
			"inherits": "macos-base",
			"binaryDir": "${sourceDir}/build/cmake/${hostSystemName}-x86_64/Debug/",
			"installDir": "${sourceDir}/build/cmake/install/${hostSystemName}-x86_x64/Debug/",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Debug"
			}
		},
		{
			"name": "macos-release",
			"displayName": "x64 Release",
			"inherits": "macos-base",
			"binaryDir": "${sourceDir}/build/cmake/${hostSystemName}-x86_64/Release/",
			"installDir": "${sourceDir}/build/cmake/install/${hostSystemName}-x86_x64/Release/",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Release"
			}
		},
		{
			"name": "macos-shipping",
			"displayName": "x64 Shipping",
			"inherits": "macos-base",
			"binaryDir": "${sourceDir}/build/cmake/${hostSystemName}-x86_64/Shipping/",
			"installDir": "${sourceDir}/build/cmake/install/${hostSystemName}-x86_x64/Shipping/",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Release",
				"VT_BUILD_SHIPPING": "true"
			}
		}
	],
	"buildPresets": [
		{
			"name": "windows-x64-debug",
			"configurePreset": "windows-x64-debug",
			"condition": {
				"type": "equals",
				"lhs": "${hostSystemName}",
				"rhs": "Windows"
			}
		},
		{
			"name": "windows-x64-release",
			"configurePreset": "windows-x64-release",
			"condition": {
				"type": "equals",
				"lhs": "${hostSystemName}",
				"rhs": "Windows"
			}
		},
		{
			"name": "windows-x64-shipping",
			"configurePreset": "windows-x64-shipping",
			"condition": {
				"type": "equals",
				"lhs": "${hostSystemName}",
				"rhs": "Windows"
			}
		},
		{
			"name": "linux-debug",
			"configurePreset": "linux-debug",
			"condition": {
				"type": "equals",
				"lhs": "${hostSystemName}",
				"rhs": "Linux"
			}
		},
		{
			"name": "linux-release",
			"configurePreset": "linux-release",
			"condition": {
				"type": "equals",
				"lhs": "${hostSystemName}",
				"rhs": "Linux"
			}
		},
		{
			"name": "linux-shipping",
			"configurePreset": "linux-shipping",
			"condition": {
				"type": "equals",
				"lhs": "${hostSystemName}",
				"rhs": "Linux"
			}
		},
		{
			"name": "macos-debug",
			"configurePreset": "macos-debug",
			"condition": {
				"type": "equals",
				"lhs": "${hostSystemName}",
				"rhs": "Darwin"
			}
		},
		{
			"name": "macos-release",
			"configurePreset": "macos-release",
			"condition": {
				"type": "equals",
				"lhs": "${hostSystemName}",
				"rhs": "Darwin"
			}
		},
		{
			"name": "macos-shipping",
			"configurePreset": "macos-shipping",
			"condition": {
				"type": "equals",
				"lhs": "${hostSystemName}",
				"rhs": "Darwin"
			}
		}
	],
	"packagePresets": [
		{
			"name": "windows-x64-shipping",
			"configurePreset": "windows-x64-shipping",
			"packageDirectory": "${sourceDir}/build/cmake/pack/${hostSystemName}/",
			"generators": [
				"ZIP"
			],
			"configurations": [
				"Release"
			],
			"output": {
				"debug": false,
				"verbose": true
			},
			"condition": {
				"type": "equals",
				"lhs": "${hostSystemName}",
				"rhs": "Windows"
			},
			"configFile": "CPackConfig.cmake"
		},
		{
			"name": "linux-x64-shipping",
			"configurePreset": "linux-shipping",
			"packageDirectory": "${sourceDir}/build/cmake/pack/${hostSystemName}/",
			"generators": [
				"TGZ"
			],
			"configurations": [
				"Release"
			],
			"output": {
				"debug": false,
				"verbose": true
			},
			"condition": {
				"type": "equals",
				"lhs": "${hostSystemName}",
				"rhs": "Linux"
			},
			"configFile": "CPackConfig.cmake"
		},
		{
			"name": "macos-x64-shipping",
			"configurePreset": "macos-shipping",
			"packageDirectory": "${sourceDir}/build/cmake/pack/${hostSystemName}/",
			"generators": [
				"TGZ"
			],
			"configurations": [
				"Release"
			],
			"output": {
				"debug": false,
				"verbose": true
			},
			"condition": {
				"type": "equals",
				"lhs": "${hostSystemName}",
				"rhs": "Darwin"
			},
			"configFile": "CPackConfig.cmake"
		}
	]
}
